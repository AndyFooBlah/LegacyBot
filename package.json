{
  "name": "legacybot",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-for-secrets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check:bundle": "node scripts/check-bundle-for-secrets.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "eval:groundedness": "tsx evals/groundedness.ts",
    "eval:pii:build": "tsx evals/pii/build-denylist.ts",
    "eval:pii": "tsx evals/pii/scan.ts",
    "eval:family:shape": "tsx evals/family/corpus-shape.ts --fixture",
    "eval:family:seed": "tsx evals/family/seed.ts",
    "typecheck:evals": "tsc -p evals/tsconfig.json"
  },
  "dependencies": {
    "@andyfooblah/knowledge-common": "^1.3.1",
    "@andyfooblah/voice-common": "^0.16.2",
    "@google/genai": "^2.8.0",
    "firebase": "^12.9.0",
    "jspdf": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-admin": "^14.5.1",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
